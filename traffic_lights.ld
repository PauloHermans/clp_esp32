LDmicro0.1
MICRO=ANSI C Code
CYCLE=1000
CRYSTAL=240000000
BAUD=2400

IO LIST
    YDO1 at 0
    YDO2 at 0
    YDO3 at 0
END

PROGRAM
RUNG
    CONTACTS RM1 1
    COIL YDO1 0 0 0
END
RUNG
    CONTACTS RM3 1
    TON TT1 5000000
    COIL RM1 0 0 0
END
RUNG
    CONTACTS RM1 0
    CONTACTS RM2 1
    COIL YDO2 0 0 0
END
RUNG
    CONTACTS RM1 0
    TON TT2 2000000
    COIL RM2 0 0 0
END
RUNG
    CONTACTS RM2 0
    COIL YDO3 0 0 0
END
RUNG
    CONTACTS RM2 0
    TON TT3 5000000
    COIL RM3 0 0 0
END
